NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_API_SECRET=
CRON_SECRET=

# Transactional contact email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=507 Head <notifications@your-domain.example>
CONTACT_NOTIFICATION_EMAIL=owner@your-domain.example

# Instagram Graph API (Business/Creator account connected to a Facebook Page)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Keep this configurable so it can be upgraded when Meta retires an API version.
INSTAGRAM_GRAPH_API_VERSION=v23.0
